   "source": "\\begin{verbatim}\\newcommand{\\X}{x}\\end{verbatim}",
   "expected": []
  },
  {
   "name": "unfinished definition",
   "source": "\\newcommand{\\X}{x",
   "expected": []
  },
  {
   "name": "comment inside body",
   "source": "\\newcommand{\\f}[1]{\\frac{#1}{2} % }\n}",
   "expected": [
    {
     "kind": "newCommand",
     "name": "\\f",
     "mathJax": "\\newcommand{\\f}[1]{\\frac{#1}{2} % }\n}"
    }
   ]
  },
  {
   "name": "definition inside math is local",
   "source": "$\\newcommand{\\X}{x}\\X$",
   "expected": []
  },
  {
   "name": "newcommand: comment between optional arg and body",
   "source": "\\newcommand{\\F}[1]% sized variant\n{F_{#1}}",
