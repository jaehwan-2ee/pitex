{
 "comment": "Shared by Swift (TexCoreTests/EquationPreviewSyntaxTests) and Rust (language-core tests/equation_preview.rs). U+2038 '‸' marks the caret (removed before scanning); mode 'character' treats it as the pointer's character position.",
 "regions": [
  {
   "name": "inline dollar",
   "source": "$a‸+b$",
   "expected": {
    "text": "$a+b$",
    "render": "a+b",
    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "inline parenthesis",
   "source": "Text \\(a+‸b\\) end",
   "expected": {
    "text": "\\(a+b\\)",
    "render": "a+b",
    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "display bracket",
   "source": "\\[\na‸+b\n\\]",
   "expected": {
    "text": "\\[\na+b\n\\]",
    "render": "\na+b\n",
    "display": true,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "display dollars",
   "source": "$$x‸^2$$",
   "expected": {
    "text": "$$x^2$$",
    "render": "x^2",
    "display": true,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "equation body only",
   "source": "\\begin{equation}\na‸+b\n\\end{equation}",
   "expected": {
    "text": "\\begin{equation}\na+b\n\\end{equation}",
    "render": "\na+b\n",
    "display": true,
    "environment": "equation",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "align whole environment",
   "source": "\\begin{align}\na &= b \\\\\nc &= d‸\n\\end{align}",
   "expected": {
    "text": "\\begin{align}\na &= b \\\\\nc &= d\n\\end{align}",
    "render": "\\begin{align}\na &= b \\\\\nc &= d\n\\end{align}",
    "display": true,
    "environment": "align",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "gather star",
