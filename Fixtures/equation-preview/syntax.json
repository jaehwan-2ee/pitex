    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "unfinished fraction",
   "source": "$\\frac{‸",
   "expected": {
    "text": "$\\frac{",
    "complete": false
   }
  },
  {
   "name": "unfinished opener",
   "source": "text $‸",
   "expected": {
    "text": "$",
    "complete": false
   }
  },
  {
   "name": "paragraph break ends unfinished math",
   "source": "$a + b‸\n\nNext $c$",
   "expected": {
    "text": "$a + b",
    "complete": false
   }
  },
  {
   "name": "math after an unfinished paragraph",
   "source": "$a + b\n\nNext $c‸$",
   "expected": {
    "text": "$c$",
    "render": "c",
    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "par ends unfinished math",
   "source": "$a‸ \\par b$",
   "expected": {
    "text": "$a ",
    "complete": false
   }
  },
  {
   "name": "mismatched end",
   "source": "\\begin{equation}\na‸\n\\end{align}",
   "expected": {
    "text": "\\begin{equation}\na\n",
    "complete": false
   }
  },
  {
   "name": "lone dollar inside display dollars",
   "source": "$$ a ‸$ b",
   "expected": {
    "text": "$$ a ",
    "complete": false
   }
  },
  {
   "name": "unbalanced braces closed by dollar",
   "source": "$\\frac{1}{2‸$",
   "expected": {
    "text": "$\\frac{1}{2$",
    "render": "\\frac{1}{2",
    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": false
   }
  },
  {
   "name": "nothing after end document",
   "source": "\\end{document}\n$x‸$",
   "expected": null
  },
  {
   "name": "caret just after closer",
   "source": "$x$‸ text",
   "expected": {
    "text": "$x$",
    "render": "x",
    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "caret just before opener",
   "source": "‸$x$",
   "expected": null
