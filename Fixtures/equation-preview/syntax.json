 ],
 "definitions": [
  {
   "name": "newcommand",
   "source": "\\newcommand{\\R}{\\mathbb{R}}",
   "expected": [
    {
     "kind": "newCommand",
     "name": "\\R",
     "mathJax": "\\newcommand{\\R}{\\mathbb{R}}"
    }
   ]
  },
  {
   "name": "renewcommand star without braces",
   "source": "\\renewcommand*\\vect[1]{\\mathbf{#1}}",
   "expected": [
    {
     "kind": "renewCommand",
     "name": "\\vect",
     "mathJax": "\\renewcommand{\\vect}[1]{\\mathbf{#1}}"
    }
   ]
  },
  {
   "name": "providecommand with default",
   "source": "\\providecommand{\\abs}[2][x]{|#2|_{#1}}",
   "expected": [
    {
     "kind": "provideCommand",
     "name": "\\abs",
     "mathJax": "\\newcommand{\\abs}[2][x]{|#2|_{#1}}"
    }
   ]
  },
  {
   "name": "starred operator",
   "source": "\\DeclareMathOperator*{\\argmax}{arg\\,max}",
   "expected": [
    {
     "kind": "declareMathOperator",
     "name": "\\argmax",
     "mathJax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}"
    }
   ]
  },
  {
   "name": "operator without braces",
   "source": "\\DeclareMathOperator\\Tr{Tr}",
   "expected": [
    {
     "kind": "declareMathOperator",
     "name": "\\Tr",
     "mathJax": "\\DeclareMathOperator{\\Tr}{Tr}"
    }
   ]
  },
  {
   "name": "newenvironment",
   "source": "\\newenvironment{mat}[1][b]{\\begin{#1matrix}}{\\end{#1matrix}}",
   "expected": [
    {
     "kind": "newEnvironment",
     "name": "mat",
     "mathJax": "\\newenvironment{mat}[1][b]{\\begin{#1matrix}}{\\end{#1matrix}}"
    }
   ]
  },
  {
   "name": "renewenvironment",
   "source": "\\renewenvironment{proof}{\\text{P:}}{}",
   "expected": [
