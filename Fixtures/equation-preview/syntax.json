    "text": "$x \\text{ costs $5$ total} y$",
    "render": "x \\text{ costs $5$ total} y",
    "display": false,
    "environment": null,
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "verbatim environment",
   "source": "\\begin{verbatim}\n$x‸$\n\\end{verbatim}",
   "expected": null
  },
