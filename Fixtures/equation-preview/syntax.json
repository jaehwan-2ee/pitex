     "kind": "renewEnvironment",
     "name": "proof",
     "mathJax": "\\renewenvironment{proof}{\\text{P:}}{}"
    }
   ]
  },
  {
   "name": "commented definition",
   "source": "% \\newcommand{\\X}{x}\n\\newcommand{\\Y}{y}",
