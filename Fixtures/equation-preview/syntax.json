    }
   ]
  },
  {
   "name": "paragraph break must not complete a definition",
   "source": "\\newcommand{\\F}\n\n{F}\n$% no math invented here\nx$",
   "expected": []
  },
  {
   "name": "escaped percent inside definition body",
   "source": "\\newcommand{\\pct}{25\\%}",
   "expected": [
    {
     "kind": "newCommand",
     "name": "\\pct",
     "mathJax": "\\newcommand{\\pct}{25\\%}"
    }
   ]
  },
  {
   "name": "comment ends a definition, next command starts fresh",
   "source": "\\newcommand{\\a}{x}% tail comment\n\\newcommand{\\b}{y}",
   "expected": [
