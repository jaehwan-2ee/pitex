    {
     "kind": "newCommand",
     "name": "\\b",
     "mathJax": "\\newcommand{\\b}{y}"
    }
   ]
  }
 ],
 "includes": [
  {
   "name": "include forms",
   "source": "\\input{commands}\n\\include{ch/one}\n\\usepackage[opt]{mystyle, amsmath}\n\\import{dir}{file}\n% \\input{no}\n\\begin{verbatim}\\input{no}\\end{verbatim}",
   "expected": [
    "commands",
    "ch/one",
    "mystyle.sty",
    "amsmath.sty",
    "dir/file"
   ]
  },
  {
   "name": "comments inside argument lists",
   "source": "\\usepackage{%\n  amsmath, % trailing note\n  hyperref}\n\\input{dir% comment ends here\n}\n\\input{path% no newline\n}",
   "expected": [
    "amsmath.sty",
    "hyperref.sty",
    "dir",
    "path"
   ]
  },
  {
   "name": "escaped percent inside arguments",
   "source": "\\input{my\\%file}\n\\usepackage{pack\\%age}",
   "expected": [
    "my\\%file",
    "pack\\%age.sty"
   ]
  },
  {
   "name": "CRLF endings and NBSP arguments",
   "source": "\\usepackage{%\r\n  amsmath\r\n}\r\n\\input{ hard}",
   "expected": [
    "amsmath.sty",
    " hard"
   ]
  }
 ],
 "contexts": [
  {
   "name": "first equation sees included definitions",
   "files": {
    "/p/main.tex": "\\documentclass{article}\n\\input{commands}\n\\newcommand{\\A}{a}\n\\begin{document}\n$x \\in \\R‸$\n\\renewcommand{\\R}{\\mathbf{R}}\n$y \\in \\R$\n\\input{chapters/chapter}\n\\end{document}\n",
    "/p/commands.tex": "\\newcommand{\\R}{\\mathbb{R}}\n\\providecommand{\\A}{b}\n\\DeclareMathOperator{\\Tr}{Tr}\n",
    "/p/chapters/chapter.tex": "\\providecommand{\\A}{z}\n\\providecommand{\\B}{c}\n$z$\n"
   },
   "root": "/p/main.tex",
   "active": "/p/main.tex",
   "expected": [
    "\\newcommand{\\R}{\\mathbb{R}}",
    "\\newcommand{\\A}{b}",
    "\\DeclareMathOperator{\\Tr}{Tr}",
    "\\newcommand{\\A}{a}"
   ],
   "body": []
  },
  {
   "name": "redefinition applies after it",
   "files": {
    "/p/main.tex": "\\documentclass{article}\n\\input{commands}\n\\newcommand{\\A}{a}\n\\begin{document}\n$x \\in \\R$\n\\renewcommand{\\R}{\\mathbf{R}}\n$y \\in \\R‸$\n\\input{chapters/chapter}\n\\end{document}\n",
    "/p/commands.tex": "\\newcommand{\\R}{\\mathbb{R}}\n\\providecommand{\\A}{b}\n\\DeclareMathOperator{\\Tr}{Tr}\n",
    "/p/chapters/chapter.tex": "\\providecommand{\\A}{z}\n\\providecommand{\\B}{c}\n$z$\n"
   },
   "root": "/p/main.tex",
   "active": "/p/main.tex",
   "expected": [
    "\\newcommand{\\R}{\\mathbb{R}}",
    "\\newcommand{\\A}{b}",
    "\\DeclareMathOperator{\\Tr}{Tr}",
    "\\newcommand{\\A}{a}",
    "\\renewcommand{\\R}{\\mathbf{R}}"
   ],
   "body": [
    "\\renewcommand{\\R}{\\mathbf{R}}"
   ]
  },
  {
   "name": "included chapter sees the main tree before it",
   "files": {
    "/p/main.tex": "\\documentclass{article}\n\\input{commands}\n\\newcommand{\\A}{a}\n\\begin{document}\n$x \\in \\R$\n\\renewcommand{\\R}{\\mathbf{R}}\n$y \\in \\R$\n\\input{chapters/chapter}\n\\end{document}\n",
    "/p/commands.tex": "\\newcommand{\\R}{\\mathbb{R}}\n\\providecommand{\\A}{b}\n\\DeclareMathOperator{\\Tr}{Tr}\n",
    "/p/chapters/chapter.tex": "\\providecommand{\\A}{z}\n\\providecommand{\\B}{c}\n$z‸$\n"
