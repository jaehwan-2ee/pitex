    "environment": "gather*",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "math environment is inline",
   "source": "\\begin{math}a‸\\end{math}",
   "expected": {
    "text": "\\begin{math}a\\end{math}",
    "render": "a",
    "display": false,
    "environment": "math",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "displaymath body",
   "source": "\\begin{displaymath}a‸\\end{displaymath}",
   "expected": {
    "text": "\\begin{displaymath}a\\end{displaymath}",
    "render": "a",
    "display": true,
    "environment": "displaymath",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "standalone aligned",
   "source": "\\begin{aligned}\na &= b‸\n\\end{aligned}",
   "expected": {
    "text": "\\begin{aligned}\na &= b\n\\end{aligned}",
    "render": "\\begin{aligned}\na &= b\n\\end{aligned}",
    "display": true,
    "environment": "aligned",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "standalone cases",
   "source": "\\begin{cases} a‸ \\end{cases}",
   "expected": {
    "text": "\\begin{cases} a \\end{cases}",
    "render": "\\begin{cases} a \\end{cases}",
    "display": true,
    "environment": "cases",
    "complete": true,
    "wellFormed": true
   }
  },
  {
   "name": "split inside equation belongs to equation",
