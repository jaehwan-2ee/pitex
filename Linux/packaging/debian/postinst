#!/bin/sh
set -e

# Refresh the desktop database and icon cache so Pitex shows up in the
# applications menu right after `apt install ./Pitex-*.deb`. Without this,
# the entry can stay invisible until the next login on Ubuntu 22.04.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

#DEBHELPER#

exit 0
